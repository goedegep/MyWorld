<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="model" nsURI="http://goedegep.media/mediadb/model" nsPrefix="mediadb">
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="documentation" value=""/>
  </eAnnotations>
  <eClassifiers xsi:type="ecore:EClass" name="Track">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A music track that may appear on one or more albums."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="duration" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EIntegerObject"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players" upperBound="-1"
        eType="#//Player" unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="artist" eType="#//Artist"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="parts" upperBound="-1"
        eType="#//TrackPart" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="authors" upperBound="-1"
        eType="#//Artist" unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="referredBy" upperBound="-1"
        eType="#//TrackReference" eOpposite="#//TrackReference/track"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MediaDb">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This interface is the top level interface for the media (music) database.&lt;br>&#xD;&#xA;It contains both general information like information on albums and artists, and personal information like whether I want to have an album and on what media I have it.&lt;/br>&#xD;&#xA;The interface names for personal information start with 'My', being {@code MyInfo} and {@code MyTrackInfo}.&lt;br/>&#xD;&#xA;&lt;h2>Overview of the interfaces&lt;/h2>&#xD;&#xA;&lt;h3>{@link Album}&lt;/h3>&lt;&#xD;&#xA;The database contains a list of albums, where an album can be any collection of tracks.&lt;br/>&#xD;&#xA;An album consists of one or more discs.&#xD;&#xA;&lt;h3>{@link Disc}&lt;/h3>&#xD;&#xA;This interface represents a physical disc like a CD or SACD, but can also represent any collection of tracks.&lt;br/>&#xD;&#xA;A disc contains tracks, represented by track references ({@code TrackReference}).&#xD;&#xA;&lt;h3>{@link TrackReference}&lt;/h3>&#xD;&#xA;The tracks of a disc are specified by track references and not directly by tracks. Main reason for this is that the same track (the same recording) can appear on more than one album.&#xD;&#xA;&lt;h3>{@link Track}&lt;/h3>&#xD;&#xA;The database contains a list of tracks, where a track represents a single song/recording.&#xD;&#xA;The tracks are referred to (via track references) by the tracks of the discs of the albums and by the tracks in the track collections.&#xD;&#xA;&lt;h3>{@link TrackCollection}&lt;/h3>&#xD;&#xA;The database also contains track collections, which are collections of tracks of a specific genre and for which you don't have albums details.&#xD;&#xA;&lt;h3>{@link Artist}&lt;/h3>&#xD;&#xA;The database has a list of artists, which may be an artist of an album or track, or a player on an album or track, or an author of a track.&#xD;&#xA;&lt;h3>{@link Video}&lt;/h3>&#xD;&#xA;The database has a list of videos."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="artists" upperBound="-1"
        eType="#//Artist" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The collection of artists in the database."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="albums" upperBound="-1"
        eType="#//Album" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The collection of albums in the database."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="tracks" upperBound="-1"
        eType="#//Track" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trackcollections" upperBound="-1"
        eType="#//TrackCollection" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The collection of track collections in the database."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="videos" upperBound="-1"
        eType="#//Video" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The collection of videos in the database."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Artist">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This inteface provides information on an artist. An artist can be the artist of an album or track, or a player on an album or track. An artist can also be the container artist of an  artist."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="name" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The name of the artist."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="containerArtist" eType="#//Artist"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Some artists have albums under various names, which can best be grouped. For example &quot;Bob Marley&quot; and &quot;Bob Marley The Wailers&quot;. In this case &quot;Bob Marley&quot; is the 'containerArtist' of &quot;Bob Marley The Wailers&quot;."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="photo" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The filename of a photo of the artist."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="style" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A free format style of the artist."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="myComments" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="My comments about the artist."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="sample" eType="#//TrackReference"
        unsettable="true" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Album">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="In this model an album can be any collection of tracks. It can be an LP, CD, BD, or your own compilation of tracks.&lt;br/>&#xD;&#xA;An album consists of one or more discs. So even if you have your own compilation of tracks, which you only have on your harddisk, this is still handled via tracks on a disc."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The album title."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="releaseDate" eType="ecore:EDataType ../../goedegep.types.model/model/types.ecore#//EFlexDate"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The date on which the album was released (issued)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="discs" upperBound="-1"
        eType="#//Disc" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The discs of the album. Even if an album has no physicals discs, the track references will be divided over one of more discs."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="artist" eType="#//Artist"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imagesFront" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of file names for the images on the front of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="id" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The official id of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="players" upperBound="-1"
        eType="#//Player" unsettable="true" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The list of players on this album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imagesFrontInside" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of file names for the images on the inside of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imagesBack" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of file names for the images on the back of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="imagesLabel" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of file names for the images on the label of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="descriptionTitle" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A title for the description of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A free text description of the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="myInfo" lowerBound="1"
        eType="#//MyInfo" unsettable="true" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Your personal information on the album.&lt;br/>&#xD;&#xA;This information shall always be there, as the {@albumType} is mandatory."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="soundtrack" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="If set to true, this indicates that the album is a movie soundtrack."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TrackReference">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This used for (my) compilation albums."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="track" lowerBound="1" eType="#//Track"
        unsettable="true" eOpposite="#//Track/referredBy"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="bonusTrack" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="myTrackInfo" eType="#//MyTrackInfo"
        unsettable="true" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="originalAlbumTrackReference"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="If set this track reference indicates that this track is the track on the original album.&lt;br/>&#xD;&#xA;This can e.g. be used to create the file name for a track in a compilation album or a track collection, where the original album release year and tiltle can be part of the name.&lt;br/>&#xD;&#xA;You can of course use this attribute in a practical way. If you only have the album information of a compilation album containing a certain track, you can still set this as the original album."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Disc">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A disc of an {@code Album}."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional title of a disc."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trackReferences" lowerBound="1"
        upperBound="-1" eType="#//TrackReference" containment="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="MediumType">
    <eLiterals name="NOT_SET" value="-1" literal="&lt;not-set>"/>
    <eLiterals name="CD_AUDIO" value="1" literal="CD audio"/>
    <eLiterals name="CDR_AUDIO" value="2" literal="CDR audio"/>
    <eLiterals name="CDRW_AUDIO" value="3" literal="CDRW audio"/>
    <eLiterals name="LP" value="4" literal="lp"/>
    <eLiterals name="SINGLE" value="5" literal="single"/>
    <eLiterals name="SACD" value="6"/>
    <eLiterals name="DVD_VIDEO" value="7" literal="DVD video"/>
    <eLiterals name="CD_ROM" value="8" literal="CD ROM"/>
    <eLiterals name="DVD_ROM" value="9" literal="DVD ROM"/>
    <eLiterals name="HARDDISK" value="10" literal="harddisk"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MediumInfo">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="mediumType" eType="#//MediumType"
        defaultValueLiteral="&lt;not-set>" unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="informationType" eType="#//InformationType"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceBitRate" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sourceType" eType="#//InformationType"
        unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MyInfo">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This interface is used to add your personel information to an album."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="albumReferences" upperBound="-1"
        eType="#//Album" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References to other albums. For example if you have only some tracks of the album available in a compilation album, refer to this compilation album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="myComments" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Your free text comments on the album."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iveHadOnLP" lowerBound="1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EBoolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Set this value to true if you had the album on LP."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iWant" eType="#//IWant"
        defaultValueLiteral="&lt;not-set>" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indication on whether you want to have this album or not.&lt;br/>&#xD;&#xA;If you already have the album, this attribute shall not be set.&lt;br/>&#xD;&#xA;This attribute shall only be used if the information is the same for all tracks."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="iHaveOn" upperBound="-1"
        eType="#//MediumInfo" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="albumType" eType="#//AlbumType"
        defaultValueLiteral="NORMAL_ALBUM" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The kind of album, see {@link AlbumType}."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="IWant">
    <eLiterals name="YES" literal="Yes"/>
    <eLiterals name="NO" literal="No"/>
    <eLiterals name="DONT_KNOW" literal="Don't know"/>
    <eLiterals name="NOT_SET" value="-1" literal="&lt;not-set>"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="InformationType">
    <eLiterals name="NOT_SET" value="-1" literal="&lt;not-set>"/>
    <eLiterals name="MP3" value="1"/>
    <eLiterals name="VINYL_ANALOG" value="2"/>
    <eLiterals name="M2TS" value="4"/>
    <eLiterals name="FLAC" value="5"/>
    <eLiterals name="WAV" value="6"/>
    <eLiterals name="APE" value="7"/>
    <eLiterals name="AIFF" value="8"/>
    <eLiterals name="DSF" value="8"/>
    <eLiterals name="OPUS" value="9"/>
    <eLiterals name="SACD_MC" value="10"/>
    <eLiterals name="SACD" value="11"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Player">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This interface provides information on someone who plays/performs on an album or track. It consists of an {@code Artist} combined with the instrument played by that artist (where vocals are also seen as an instrument)."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="artist" eType="#//Artist"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The player."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="instruments" upperBound="-1"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of instruments played by this player. Vocals is also seen as an instrument. An instrument is a free format text."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TrackPart">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="Collection">
    <eLiterals name="EASY_LISTENING" literal="Easy Listening">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Easy listening tracks."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="FILM_BACKING_TRACKS" value="1" literal="Film Backing Tracks">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Tracks that can be used as backing tracks in movies you edit."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="FRANSTALIG" value="2" literal="Franstalig">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="French track."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="KLASSIEK" value="3" literal="Klassiek">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Classical music tracks."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NEDERLANDSTALIG" value="4" literal="Nederlandstalig">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Dutch tracks."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="POP" value="5" literal="Pop">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Pop songs."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="ROCK" value="6" literal="Rock">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Rock music."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="NOT_SET" value="-1" literal="&lt;not-set>">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates that the value isn't set."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="PUNK" value="8" literal="Punk">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Punk and new wave tracks."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="SAMPLE" value="9">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Artist sample tracks."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="MyTrackInfo">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="iWant and iHaveOn are related as follows:&#xD;&#xA;if iWant is set, iHaveOn shall not be set.&#xD;&#xA;If iHaveOn is set, iWant shall not be set."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="iHaveOn" upperBound="-1"
        eType="#//MediumInfo" unsettable="true" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="iWant" eType="#//IWant"
        defaultValueLiteral="&lt;not-set>" unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trackReference" eType="#//TrackReference"
        unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DiscAndTrackNrs">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="discNr" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        unsettable="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="trackNrs" lowerBound="1"
        upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"
        unsettable="true"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="TrackCollection">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A collection of tracks of a certain category (see {@Collection})."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="collection" eType="#//Collection"
        defaultValueLiteral="&lt;not-set>" unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specification of the kind of tracks in a collection."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="trackReferences" upperBound="-1"
        eType="#//TrackReference" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The references of the tracks in a track collection."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Video">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This interface provides information on a video."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The title of the video."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date" eType="ecore:EDataType ../../goedegep.types.model/model/types.ecore#//EFlexDate"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The release or creation date of the video."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="image" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The filename of a picture for the video."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="subjects" upperBound="-1"
        eType="#//Subject" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The subjects of the video."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="Subject">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="This interface describes a subject of a {@code Video}."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="title" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The title of the subject."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="tags" upperBound="-1" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of free format tags (or keywords)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="date" eType="ecore:EDataType ../../goedegep.types.model/model/types.ecore#//EFlexDate"
        unsettable="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The date related to the subject."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" name="AlbumType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The kind of album."/>
    </eAnnotations>
    <eLiterals name="NORMAL_ALBUM" literal="Normal">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This is what most albums (e.g. CD or LP) you buy in the (online) shop are.&lt;br/>&#xD;&#xA;It is an album from a single artist with mostly tracks that appear on an album for the first time.&#xD;&#xA;In your collection you may have the complete album, or just a number of tracks. These tracks can be on a MyCompilation album, or they can be in a track collection."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="COMPILATION_ALBUM" value="1" literal="Compilation">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Also this is an album from a single artist, but the tracks were earlier released on a number of Normal albums."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="VARIOUS_ARTISTS_ALBUM" value="2" literal="Various Artists">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This is an album where there a tracks from different artists. Therefore the artist shall be filled in per track."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals name="OWN_COMPILATION_ALBUM" value="4" literal="Own Compilation">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="This is an album you created yourself."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
</ecore:EPackage>
